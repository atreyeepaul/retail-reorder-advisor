@page "/health-summary"
@using System.Globalization
@using Reorder.Core.Models
@model HealthSummaryModel
@{
    ViewData["Title"] = "Health summary";
    var flags = new[] { Flag.Urgent, Flag.StockoutRisk, Flag.DeadStock, Flag.Overstock, Flag.Healthy };
    static int Count(IReadOnlyDictionary<string, int> counts, string code) => counts.TryGetValue(code, out var c) ? c : 0;
    static string SegClass(Flag flag) => flag.ToCode().ToLowerInvariant().Replace('_', '-');
    static string Inr(decimal v) => "₹" + v.ToString("N0", CultureInfo.InvariantCulture);
}

<h1>Inventory health</h1>

@if (Model.Summary is null)
{
    <section class="card">
        <p><strong>The pipeline hasn't run yet.</strong></p>
        <p class="muted">
            Upload the daily CSVs and trigger the advisor job; the health summary will appear here.
        </p>
        <p>Health endpoint: <a href="/health">/health</a></p>
    </section>
}
else
{
    var summary = Model.Summary;
    var counts = summary.CountsByFlag;
    var atRisk = Count(counts, "URGENT") + Count(counts, "STOCKOUT_RISK");
    var total = summary.SkuCount;

    <p class="muted caption">
        As of <strong>@summary.AsOf</strong> · @summary.SkuCount SKUs ·
        generated @summary.GeneratedAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) UTC
    </p>

    <div class="tiles">
        <div class="tile">
            <div class="label">At-risk SKUs</div>
            <div class="value">@atRisk</div>
            <div class="muted">Urgent + stockout risk</div>
        </div>
        <div class="tile">
            <div class="label">Overstock value</div>
            <div class="value">@Inr(summary.OverstockValue)</div>
            <div class="muted">@Count(counts, "OVERSTOCK") SKUs over target</div>
        </div>
        <div class="tile">
            <div class="label">Dead stock</div>
            <div class="value">@Count(counts, "DEAD_STOCK") SKUs</div>
            <div class="muted">@Inr(summary.DeadStockValue) tied up</div>
        </div>
        <div class="tile">
            <div class="label">Est. lost sales avoided</div>
            <div class="value">@Inr(summary.EstLostSalesAvoided)</div>
            <div class="muted">By ordering urgent SKUs now</div>
        </div>
        <div class="tile @(summary.QuarantinedRows > 0 ? "tile--warn" : null)">
            <div class="label">Last run</div>
            <div class="value">OK</div>
            <div class="muted">
                @summary.RunDurationMs ms · @summary.QuarantinedRows quarantined
            </div>
        </div>
    </div>

    <h2>Flag distribution</h2>
    <div class="flag-bar" role="img" aria-label="Distribution of the @total SKUs across flags">
        @foreach (var f in flags)
        {
            var code = f.ToCode();
            var count = Count(counts, code);
            if (count == 0) { continue; }
            var pct = total > 0 ? (double)count / total * 100 : 0;
            <span class="seg seg--@SegClass(f)"
                  style="width:@(pct.ToString("0.###", CultureInfo.InvariantCulture))%"
                  title="@code: @count"></span>
        }
    </div>
    <div class="legend">
        @foreach (var f in flags)
        {
            <span class="legend-item">
                <span class="swatch seg--@SegClass(f)"></span>
                @f.ToCode() (@Count(counts, f.ToCode()))
            </span>
        }
    </div>
}
