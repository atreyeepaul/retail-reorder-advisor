<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- One package source only. With Central Package Management, multiple sources
       raise NU1507, which TreatWarningsAsErrors would turn into a build error. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
